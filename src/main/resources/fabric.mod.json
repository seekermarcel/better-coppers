{
	"schemaVersion": 1,
	"id": "bettercoppers",
	"version": "${version}",
	"name": "Better Coppers",
	"description": "Copper Golems that do real work: sorting, mining, farming, fishing, couriering and more.",
	"authors": ["Marcel Meier"],
	"contact": {
		"homepage": "https://github.com/seekermarcel/better-coppers",
		"sources": "https://github.com/seekermarcel/better-coppers",
		"issues": "https://github.com/seekermarcel/better-coppers/issues"
	},
	"license": "LGPL-3.0-only",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.bettercoppers.BetterCoppers"
		],
		"client": [
			"dev.bettercoppers.client.BetterCoppersClient"
		]
	},
	"mixins": [
		"bettercoppers.mixins.json",
		{
			"config": "bettercoppers.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
