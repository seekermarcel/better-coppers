			"dev.bettercoppers.automatisation.Automatisation"
		],
		"client": [
			"dev.bettercoppers.automatisation.client.AutomatisationClient"
		]
	},
	"mixins": [
		"bettercoppers_automatisation.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
